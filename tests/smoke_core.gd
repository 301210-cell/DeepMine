extends SceneTree
## Headless smoke test of the core autoload logic. Run with --headless --script.
func _initialize() -> void:
	await process_frame
	var GS = root.get_node("GameState")
	var SM = root.get_node("SkillManager")
	var DB = root.get_node("ResourceDatabase")
	print("items=", DB.items.size(), " blocks=", DB.blocks.filter(func(b): return b != null).size(), " skills=", DB.skills.size(), " machines=", DB.machines.size(), " collectibles=", DB.collectibles.size())
	GS.new_game(1234)
	print("cap=", GS.inventory_capacity(), " power=", GS.stat(&"mining_power"), " speed=", GS.stat(&"mining_speed"))
	print("add stone left=", GS.add_item("stone", 150), " count=", GS.count_item("stone"))
	GS.add_xp(500)
	print("level=", GS.level, " sp=", GS.skill_points, " coins=", GS.coins)
	print("can strong_swing: '", SM.can_rank_up("strong_swing"), "'")
	print("rank ok=", SM.rank_up("strong_swing"), " power now=", GS.stat(&"mining_power"), " text=", SM.effect_text("strong_swing", 1))
	print("state quick_swing=", SM.state("quick_swing"), " exploration revealed=", SM.is_branch_revealed("exploration"))
	print("refund=", SM.refund_amount(), " reset->", SM.reset_all(), " sp=", GS.skill_points)
	GS.add_item("copper_ore", 6)
	var ML = load("res://scripts/machines/machine_logic.gd")
	print("queue: '", ML.queue_recipe("smelter", 0, 3), "' queued=", ML.queued_total("smelter"))
	for i in 20: ML.tick("smelter", 1.0)
	print("smelter output=", GS.machine_state("smelter").output, " collect=", ML.collect("smelter"), " bars=", GS.count_item("copper_bar"))
	print("sell=", GS.sell_from_inventory("copper_bar", 99), " coins=", GS.coins)
	GS.add_item("geode_small", 2)
	print("geode=", GS.open_geode("geode_small"))
	var d = GS.to_dict()
	GS.from_dict(JSON.parse_string(JSON.stringify(d)))
	print("roundtrip coins=", GS.coins, " stone=", GS.count_item("stone"), " lvl=", GS.level)
	print("SMOKE OK")
	quit()
