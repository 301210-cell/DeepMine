## Hand-made 6-row macro glyphs (cap area) for the big font where auto-reduction looks wrong.
## Lowercase overrides give rows 0-7 (2 ascender, 4 x-height, 2 descender).
const BIG_OVERRIDES := {
	"K": ["#...#", "#..#.", "###..", "#..#.", "#...#", "#...#"],
	"S": [".####", "#....", ".###.", "....#", "....#", "####."],
	"3": [".###.", "....#", "..##.", "....#", "#...#", ".###."],
	"5": ["#####", "#....", "####.", "....#", "#...#", ".###."],
	"6": [".###.", "#....", "####.", "#...#", "#...#", ".###."],
	"9": [".###.", "#...#", "#...#", ".####", "....#", ".###."],
	"2": [".###.", "#...#", "...#.", "..#..", ".#...", "#####"],
	"4": ["...#.", "..##.", ".#.#.", "#####", "...#.", "...#."],
	"7": ["#####", "....#", "...#.", "..#..", "..#..", "..#.."],
	"Q": [".###.", "#...#", "#...#", "#.#.#", "#..#.", ".##.#"],
	"G": [".###.", "#....", "#.###", "#...#", "#...#", ".###."],
	"%": ["##...", "##..#", "...#.", "..#..", ".#.##", "#..##"],
	"*": ["..#..", "#.#.#", ".###.", "#.#.#", "..#..", "....."],
	"&": [".##..", "#..#.", ".##..", "#..##", "#..#.", ".##.#"],
	"$": [".####", "#.#..", ".###.", "..#.#", "####.", "..#.."],
	"@": [".###.", "#...#", "#.###", "#.###", "#....", ".###."],
	"?": [".###.", "#...#", "...#.", "..#..", ".....", "..#.."],
	"a": [".....", ".....", ".###.", ".####", "#...#", ".####", ".....", "....."],
	"e": [".....", ".....", ".###.", "#####", "#....", ".###.", ".....", "....."],
	"s": ["....", "....", ".###", "##..", "..##", "###.", "....", "...."],
	"z": ["....", "....", "####", "..#.", ".#..", "####", "....", "...."],
	"x": [".....", ".....", "#...#", ".###.", ".###.", "#...#", ".....", "....."],
	"g": [".....", ".....", ".####", "#...#", "#...#", ".####", "....#", ".###."],
	"y": ["....", "....", "#..#", "#..#", "#..#", ".###", "...#", ".##."],
	"j": ["..#", "...", "..#", "..#", "..#", "..#", "#.#", ".#."],
	"p": [".....", ".....", "####.", "#...#", "#...#", "####.", "#....", "#...."],
	"q": [".....", ".....", ".####", "#...#", "#...#", ".####", "....#", "....#"],
	"t": [".#.", ".#.", "###", ".#.", ".#.", "..#", "...", "..."],
	"f": ["..##", ".#..", "###.", ".#..", ".#..", ".#..", "....", "...."],
	"k": ["#...", "#...", "#.#.", "##..", "#.#.", "#..#", "....", "...."],
	"r": ["....", "....", "#.##", "##..", "#...", "#...", "....", "...."],
	"w": [".....", ".....", "#...#", "#.#.#", "#.#.#", ".#.#.", ".....", "....."],
	"v": [".....", ".....", "#...#", "#...#", ".#.#.", "..#..", ".....", "....."],
	"m": [".....", ".....", "##.#.", "#.#.#", "#.#.#", "#.#.#", ".....", "....."],
}

func pad(rows: Array, n: int) -> Array:
	var w := 0
	for r in rows:
		w = maxi(w, String(r).length())
	var out := []
	for i in n:
		var s: String = rows[i] if i < rows.size() else ""
		while s.length() < w:
			s += "."
		out.append(s)
	return out

func is_lower_layout(code: int) -> bool:
	var s := char(code)
	return s >= "a" and s <= "z"

## Reduce a 9-row small glyph to an 8-row macro glyph by dropping one row from the cap area.
func reduce_big(code: int, rows9: Array) -> Array:
	var key := char(code)
	if BIG_OVERRIDES.has(key):
		var o: Array = BIG_OVERRIDES[key]
		if o.size() == 6:
			return pad(o, 8)
		return pad(o, 8)
	var rows: Array = rows9.duplicate()
	var lo := 2 if is_lower_layout(code) else 1
	var del := -1
	# Prefer removing a duplicate row in the lower half, then the upper half.
	for i in range(5, lo - 1, -1):
		if rows[i] == rows[i + 1] and rows[i].contains("#"):
			del = i + 1
			break
	if del == -1:
		for i in range(5, lo - 1, -1):
			if rows[i] == rows[i + 1]:
				del = i + 1
				break
	if del == -1:
		del = 3 if is_lower_layout(code) else 2
	rows.remove_at(del)
	return rows # 8 rows

func build_font(face: String, file_base: String, size: int, line_h: int, base: int, top_off: int, scale: int, big: bool, atlas_w: int, atlas_h: int) -> void:
	var img := Image.create(atlas_w, atlas_h, false, Image.FORMAT_RGBA8)
	img.fill(Color(1, 1, 1, 0))
	var codes: Array = G.keys()
	codes.sort()
	var lines: PackedStringArray = []
	var cx := 1
	var cy := 1
	var row_h := 0
	var char_lines: PackedStringArray = []
	# Space
	char_lines.append("char id=32 x=0 y=0 width=0 height=0 xoffset=0 yoffset=0 xadvance=%d page=0 chnl=15" % (3 * scale))
	for code in codes:
		var rows: Array = pad(G[code], 9)
		if big:
			rows = reduce_big(code, rows)
		var gw: int = String(rows[0]).length()
		var first := -1
		var last := -1
		for i in rows.size():
			if String(rows[i]).contains("#"):
				if first == -1:
					first = i
				last = i
		if first == -1:
			continue
		var gh := last - first + 1
		var pw := gw * scale
		var ph := gh * scale
		if cx + pw + 1 > atlas_w:
			cx = 1
			cy += row_h + 1
			row_h = 0
		for ry in gh:
			var s: String = rows[first + ry]
			for rx in gw:
				if s[rx] == "#":
					for sy in scale:
						for sx in scale:
							img.set_pixel(cx + rx * scale + sx, cy + ry * scale + sy, Color(1, 1, 1, 1))
		var adv := pw + scale
		char_lines.append("char id=%d x=%d y=%d width=%d height=%d xoffset=0 yoffset=%d xadvance=%d page=0 chnl=15" % [code, cx, cy, pw, ph, top_off + first * scale, adv])
		cx += pw + 1
		row_h = maxi(row_h, ph)
	lines.append('info face="%s" size=%d bold=%d italic=0 charset="" unicode=1 stretchH=100 smooth=0 aa=1 padding=0,0,0,0 spacing=1,1 outline=0' % [face, size, 1 if big else 0])
	lines.append("common lineHeight=%d base=%d scaleW=%d scaleH=%d pages=1 packed=0 alphaChnl=0 redChnl=4 greenChnl=4 blueChnl=4" % [line_h, base, atlas_w, atlas_h])
	lines.append('page id=0 file="%s_0.png"' % file_base)
	lines.append("chars count=%d" % char_lines.size())
	lines.append_array(char_lines)
	var out := PX.out_root().path_join("fonts")
	DirAccess.make_dir_recursive_absolute(out)
	img.save_png(out.path_join(file_base + "_0.png"))
	var f := FileAccess.open(out.path_join(file_base + ".fnt"), FileAccess.WRITE)
	f.store_string("\n".join(lines) + "\n")
	f.close()
	print("font ", file_base, ": ", char_lines.size(), " glyphs, atlas ", atlas_w, "x", atlas_h, " used to y=", cy + row_h)
	# Validate with Godot's own BMFont loader.
	var ff := FontFile.new()
	var err := ff.load_bitmap_font(out.path_join(file_base + ".fnt"))
	print("  load_bitmap_font err=", err, " fixed_size=", ff.fixed_size, " height=", ff.get_height(size), " ascent=", ff.get_ascent(size))

func _init() -> void:
	define_glyphs()
	build_font("DeepMine Pixel", "pixel", 10, 10, 8, 1, 1, false, 128, 64)
	build_font("DeepMine Big", "pixel_big", 16, 16, 12, 0, 2, true, 256, 128)
	quit()
