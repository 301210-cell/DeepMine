	g("v", [".....", ".....", "#...#", "#...#", "#...#", ".#.#.", "..#.."])
	g("w", [".....", ".....", "#...#", "#...#", "#.#.#", "#.#.#", ".#.#."])
	g("x", [".....", ".....", "#...#", ".#.#.", "..#..", ".#.#.", "#...#"])
