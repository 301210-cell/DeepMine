	g(8226, ["..", "..", "..", "##", "##"]) # bullet
	g(215, [".....", "#...#", ".#.#.", "..#..", ".#.#.", "#...#", "....."]) # multiply
	g(8594, ["......", "...#..", "....#.", "######", "....#.", "...#..", "......"]) # right arrow
	g(8592, ["......", "..#...", ".#....", "######", ".#....", "..#...", "......"]) # left arrow
