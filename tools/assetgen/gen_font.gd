## Generates DeepMine's two bitmap fonts (AngelCode BMFont text format):
##   assets/fonts/pixel.fnt     + pixel_0.png      size 10, lineHeight 10, base 8, cap height 7
##   assets/fonts/pixel_big.fnt + pixel_big_0.png  size 16, lineHeight 16, base 12, cap height 12
## Every glyph is hand-authored below ('#' = pixel). Rows 0-6 are the cap area, rows 7-8 descenders.
## The big font is derived from the small glyphs: one row is removed from the cap area (giving a
## 6-row "macro" glyph), then every macro pixel becomes a 2x2 block -> uniform 2px chunky strokes.
## Glyphs that don't reduce nicely have hand-made macro overrides in BIG_OVERRIDES.
extends SceneTree

const PX = preload("res://px.gd")

var G := {}

func g(ch, rows: Array) -> void:
	var code: int = ch if typeof(ch) == TYPE_INT else String(ch).unicode_at(0)
	G[code] = rows

