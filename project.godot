; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="DeepMine"
config/description="DeepMine - Underground Mining Simulator. A 2D pixel-art mining adventure."
config/version="1.0.0"
run/main_scene="res://scenes/main/Boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.043, 0.063, 0.149, 1)
boot_splash/show_image=false
config/icon="res://icon.png"

[autoload]

Events="*res://scripts/autoload/events.gd"
ResourceDatabase="*res://scripts/autoload/resource_database.gd"
GameState="*res://scripts/autoload/game_state.gd"
SkillManager="*res://scripts/autoload/skill_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://assets/ui/theme.tres"

