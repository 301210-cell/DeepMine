extends Control
## Animated title backdrop shared by the Main Menu and the Loading Screen.
## All art is original pixel art generated by tools/assetgen/gen_title.gd:
##   title_bg.png (cave + stone & timber mine entrance), title_plaque.png (title + crystal crest),
##   title_pickaxe.png (mirrored for the right side) and title_meta.json (layer positions).
## Animation: pickaxes sway left/right out of phase, crystals and gems shine (twinkling sparkles
## and glints sweeping up the big crystals), lanterns and tunnel light flicker, crystal glow
## pulses, the plaque floats gently and dust drifts. Everything lives in a 640x360 stage scaled to
## cover the window.

const BG := "res://assets/backgrounds/title_bg.png"
const PLAQUE := "res://assets/backgrounds/title_plaque.png"
const PICKAXE := "res://assets/backgrounds/title_pickaxe.png"
const META := "res://assets/backgrounds/title_meta.json"
const SWAY_DEG := 4.5
const SWAY_SPEED := 0.85

var stage: Control
var _meta: Dictionary = {}
var _plaque: Sprite2D
var _plaque_y := 0.0
var _picks: Array[Sprite2D] = []
var _fx_glow: Node2D
var _fx_spark: Node2D
var _halo: Texture2D
var _t := 0.0
var _sparkles: Array = []
var _spawn_t := 0.0
var _zone_total := 0.0
var _flicker: Dictionary = {}
var _glint := {}            # active glint sweep on a crystal
var _glint_wait := 1.2
var _tip_glint := {}         # pickaxe edge glint

func _ready() -> void:
	mouse_filter = Control.MOUSE_FILTER_IGNORE
	set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	_meta = _load_meta()
	var bgc := ColorRect.new()
	bgc.color = Color("05060f")
	bgc.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	bgc.mouse_filter = Control.MOUSE_FILTER_IGNORE
	add_child(bgc)
	stage = Control.new()
	stage.size = Vector2(640, 360)
	stage.mouse_filter = Control.MOUSE_FILTER_IGNORE
	add_child(stage)
	var pic := TextureRect.new()
	pic.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	pic.stretch_mode = TextureRect.STRETCH_SCALE
	pic.texture = ResourceDatabase.tex(BG)
	pic.position = Vector2.ZERO
	pic.size = Vector2(640, 360)
	pic.mouse_filter = Control.MOUSE_FILTER_IGNORE
	stage.add_child(pic)
	_halo = load("res://scripts/world/world_renderer.gd").make_radial_texture(128, 0.0)
	var add_mat := CanvasItemMaterial.new()
	add_mat.blend_mode = CanvasItemMaterial.BLEND_MODE_ADD
	# glows sit behind the plaque/pickaxes so the title stays crisp
	_fx_glow = Node2D.new()
	_fx_glow.material = add_mat
	_fx_glow.draw.connect(_draw_glows)
	stage.add_child(_fx_glow)
	_make_pickaxes()
	_plaque = Sprite2D.new()
	_plaque.texture = ResourceDatabase.tex(PLAQUE)
	_plaque.centered = false
	var pp: Array = _meta.get("plaque_pos", [73, 6])
	_plaque_y = float(pp[1])
	_plaque.position = Vector2(float(pp[0]), _plaque_y)
	stage.add_child(_plaque)
	stage.add_child(_make_dust())
	_fx_spark = Node2D.new()
	_fx_spark.material = add_mat
	_fx_spark.draw.connect(_draw_sparkles)
	stage.add_child(_fx_spark)
	for z in _meta.get("sparkle_zones", []):
		_zone_total += float(z[5])
	for i in 12:
		_spawn_sparkle()
		if not _sparkles.is_empty():
			_sparkles[-1].life = randf() * float(_sparkles[-1].max)
	resized.connect(_fit)
	_fit()

func _load_meta() -> Dictionary:
	if not FileAccess.file_exists(META):
		return {}
	var d: Variant = JSON.parse_string(FileAccess.get_file_as_string(META))
	return d if typeof(d) == TYPE_DICTIONARY else {}

func _fit() -> void:
	var s := maxf(size.x / 640.0, size.y / 360.0)
	stage.scale = Vector2(s, s)
	stage.position = (size - Vector2(640, 360) * s) * 0.5

func _make_pickaxes() -> void:
	var tex := ResourceDatabase.tex(PICKAXE)
	var pv: Array = _meta.get("pickaxe_pivot", [94, 94])
	for side in 2:
		var key := "pick_left" if side == 0 else "pick_right"
		var info: Dictionary = _meta.get(key, {"pivot": [140, 120], "angle": 0.0})
		var s := Sprite2D.new()
		s.texture = tex
		s.centered = false
		s.flip_h = side == 1
		var px := float(pv[0]) if side == 0 else float(tex.get_width() - 1) - float(pv[0])
		s.offset = -Vector2(px, float(pv[1]))
		s.position = Vector2(float(info.pivot[0]), float(info.pivot[1]))
		s.set_meta("base", float(info.get("angle", 0.0)))
		stage.add_child(s)
		_picks.append(s)

func _make_dust() -> CPUParticles2D:
	var p := CPUParticles2D.new()
	p.amount = 34
	p.lifetime = 9.0
	p.preprocess = 9.0
	p.position = Vector2(320, 210)
	p.emission_shape = CPUParticles2D.EMISSION_SHAPE_RECTANGLE
	p.emission_rect_extents = Vector2(320, 150)
	p.direction = Vector2(0.25, -1)
	p.spread = 40.0
	p.initial_velocity_min = 2.0
	p.initial_velocity_max = 6.0
	p.gravity = Vector2(0, -1)
	p.scale_amount_min = 0.35
	p.scale_amount_max = 0.9
	var at := AtlasTexture.new()
	at.atlas = ResourceDatabase.tex("res://assets/sprites/effects/particles.png")
	at.region = Rect2(32, 0, 8, 8)
	p.texture = at
	var ramp := Gradient.new()
	ramp.set_color(0, Color(1, 0.85, 0.6, 0.0))
	ramp.add_point(0.3, Color(1, 0.9, 0.7, 0.4))
	ramp.add_point(0.7, Color(0.7, 0.85, 1.0, 0.35))
	ramp.set_color(ramp.get_point_count() - 1, Color(0.6, 0.8, 1.0, 0.0))
	p.color_ramp = ramp
	var m := CanvasItemMaterial.new()
	m.blend_mode = CanvasItemMaterial.BLEND_MODE_ADD
	p.material = m
	return p

func _process(delta: float) -> void:
	_t += delta
	# pickaxes sway gently, out of phase with each other
	for i in _picks.size():
		var s := _picks[i]
		var sway := sin(_t * SWAY_SPEED + (PI if i == 1 else 0.0)) * SWAY_DEG
		var base: float = s.get_meta("base", 0.0)
		s.rotation = deg_to_rad(base + (sway if i == 0 else -sway))
	# plaque floats by a single pixel
	_plaque.position.y = _plaque_y + round(sin(_t * 1.3) * 1.0)
	# flame flicker (smoothed random walk) for lanterns / tunnel light
	var glows: Array = _meta.get("glows", [])
	for i in glows.size():
		if int(glows[i][5]) == 1:
			_flicker[i] = lerpf(float(_flicker.get(i, 1.0)), randf_range(0.75, 1.15), 0.2)
	# sparkles
	_spawn_t -= delta
	while _spawn_t <= 0.0:
		_spawn_t += randf_range(0.06, 0.18)
		_spawn_sparkle()
	for s in _sparkles:
		s.life += delta
	_sparkles = _sparkles.filter(func(s): return s.life < s.max)
	# glint sweeps up a random big crystal every few seconds
	if _glint.is_empty():
		_glint_wait -= delta
		if _glint_wait <= 0.0:
			var cr: Array = _meta.get("crystals", [])
			if not cr.is_empty():
				_glint = {"c": cr[randi() % cr.size()], "t": 0.0}
			_glint_wait = randf_range(1.2, 2.6)
	else:
		_glint.t = float(_glint.t) + delta / 0.55
		if float(_glint.t) >= 1.25:
			_glint = {}
	# occasional glint running along a pickaxe edge
	if _tip_glint.is_empty():
		if randf() < delta * 0.25:
			_tip_glint = {"side": randi() % 2, "t": 0.0}
	else:
		_tip_glint.t = float(_tip_glint.t) + delta / 0.45
		if float(_tip_glint.t) >= 1.2:
			_tip_glint = {}
	_fx_glow.queue_redraw()
	_fx_spark.queue_redraw()

func _spawn_sparkle() -> void:
	var zones: Array = _meta.get("sparkle_zones", [])
	if zones.is_empty() or _sparkles.size() > 42:
		return
	var r := randf() * _zone_total
	var zone: Array = zones[0]
	for z in zones:
		r -= float(z[5])
		if r <= 0.0:
			zone = z
			break
	_sparkles.append({
		"p": Vector2(float(zone[0]) + randf() * float(zone[2]), float(zone[1]) + randf() * float(zone[3])),
		"life": 0.0, "max": randf_range(0.6, 1.3), "size": randf_range(2.5, 5.0),
		"col": Color(String(zone[4])), "rot": randf() < 0.35,
	})

func _halo_at(n: Node2D, p: Vector2, r: float, c: Color, a: float) -> void:
	n.draw_texture_rect(_halo, Rect2(p - Vector2(r, r), Vector2(r, r) * 2.0), false, Color(c.r, c.g, c.b, a))

func _draw_glows() -> void:
	var glows: Array = _meta.get("glows", [])
	for i in glows.size():
		var g: Array = glows[i]
		var pos := Vector2(float(g[0]), float(g[1]))
		var col := Color(String(g[3]))
		var k: float
		if int(g[5]) == 1:
			k = float(_flicker.get(i, 1.0))
		else:
			k = 0.72 + 0.28 * sin(_t * (0.9 + (i % 4) * 0.3) + i * 1.7)
		var rr := float(g[2]) * (0.92 + 0.08 * k)
		_halo_at(_fx_glow, pos, rr, col, float(g[4]) * k)
	# glint sweep on a crystal (behind the title so the crest glint is drawn in the spark layer)
	if not _glint.is_empty():
		var cr: Dictionary = _glint.c
		var a := Vector2(float(cr.a[0]), float(cr.a[1]))
		var b := Vector2(float(cr.b[0]), float(cr.b[1]))
		var t := clampf(float(_glint.t), 0.0, 1.0)
		var p := a.lerp(b, t)
		var dir := (b - a).normalized()
		var col := Color(String(cr.col))
		var fade := sin(clampf(float(_glint.t), 0.0, 1.0) * PI)
		_fx_glow.draw_line(p - dir * 5.0, p + dir * 5.0, Color(1, 1, 1, 0.85 * fade), 2.0)
		_halo_at(_fx_glow, p, 10.0, col, 0.45 * fade)

func _draw_sparkles() -> void:
	for s in _sparkles:
		var f: float = s.life / s.max
		var k := sin(f * PI)
		var sz: float = s.size * k
		var c: Color = s.col
		var p: Vector2 = s.p
		_halo_at(_fx_spark, p, sz * 2.2, c, 0.32 * k)
		var a := Color(c.r, c.g, c.b, 0.95 * k)
		_fx_spark.draw_line(p - Vector2(sz, 0), p + Vector2(sz, 0), a, 1.0)
		_fx_spark.draw_line(p - Vector2(0, sz), p + Vector2(0, sz), a, 1.0)
		if s.rot:
			var d := sz * 0.35
			var a2 := Color(a.r, a.g, a.b, a.a * 0.6)
			_fx_spark.draw_line(p - Vector2(d, d), p + Vector2(d, d), a2, 1.0)
			_fx_spark.draw_line(p - Vector2(d, -d), p + Vector2(d, -d), a2, 1.0)
		_fx_spark.draw_rect(Rect2(p - Vector2(1, 1), Vector2(2, 2)), Color(1, 1, 1, k))
	# the crest glint flash when a sweep reaches a crystal tip
	if not _glint.is_empty() and float(_glint.t) > 0.9:
		var cr: Dictionary = _glint.c
		var b := Vector2(float(cr.b[0]), float(cr.b[1]))
		var k2 := sin(clampf((float(_glint.t) - 0.9) / 0.35, 0.0, 1.0) * PI)
		var sz2 := 6.0 * k2
		_halo_at(_fx_spark, b, 12.0 * k2, Color.WHITE, 0.4 * k2)
		_fx_spark.draw_line(b - Vector2(sz2, 0), b + Vector2(sz2, 0), Color(1, 1, 1, k2), 1.0)
		_fx_spark.draw_line(b - Vector2(0, sz2), b + Vector2(0, sz2), Color(1, 1, 1, k2), 1.0)
	# pickaxe edge glint (follows the swaying sprite)
	if not _tip_glint.is_empty() and _picks.size() == 2:
		var side := int(_tip_glint.side)
		var s: Sprite2D = _picks[side]
		var tips: Array = _meta.get("pickaxe_tips", [])
		if tips.size() == 2:
			var w := float(s.texture.get_width())
			var ta := Vector2(float(tips[0][0]), float(tips[0][1]))
			var tb := Vector2(float(tips[1][0]), float(tips[1][1]))
			if side == 1:
				ta.x = w - 1.0 - ta.x
				tb.x = w - 1.0 - tb.x
			var t := clampf(float(_tip_glint.t), 0.0, 1.0)
			var local := ta.lerp(tb, t) + s.offset
			var p := s.position + local.rotated(s.rotation)
			var k3 := sin(t * PI)
			_halo_at(_fx_spark, p, 7.0, Color(0.85, 0.95, 1.0), 0.5 * k3)
			_fx_spark.draw_rect(Rect2(p - Vector2(1, 1), Vector2(2, 2)), Color(1, 1, 1, k3))
